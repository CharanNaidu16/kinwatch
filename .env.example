# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Mode -------------------------------------------------------------------
# live   = full app (phone page, webhooks, Meta API or mocks)
# replay = judges' demo: plays back recorded sessions only; refuses to start if META_API_KEY is set
MODE=live
# true = every model call is answered by mock adapters (default; costs nothing)
USE_MOCKS=true
# true = timers shortened by TIME_SCALE and claim timeout = DEMO_CLAIM_TIMEOUT_SEC (shown on /bts)
DEMO_MODE=false
TIME_SCALE=20

# --- Meta Model API ------------------------------------------------------------
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0

# --- WhatsApp Cloud API ----------------------------------------------------------
WA_GRAPH_VERSION=v25.0
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Use a permanent System User token; temporary tokens expire after ~24 h
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Your own number, digits only with country code (e.g. 91XXXXXXXXXX). Used by scratch tests only.
WA_TEST_RECIPIENT=

# --- Family (phone numbers live here and in the database only) -------------------
# JSON list, in escalation order. "aliases" = other spellings Kinwatch should accept for the name.
# FAMILY_MEMBERS_JSON=[{"name":"Priya","address":"91XXXXXXXXXX","aliases":["प्रिया"],"is_admin":true},{"name":"Rahul","address":"91XXXXXXXXXX","aliases":["राहुल"]}]
FAMILY_MEMBERS_JSON=[]
HOUSEHOLD_LANGUAGE=hi

# --- Access tokens for the phone page and the behind-the-scenes page --------------
DEVICE_TOKEN=change-me-device
BTS_TOKEN=change-me-bts

# --- Budget caps (hard limits; calls are refused once a cap is hit) ---------------
BUDGET_TOTAL_USD=20
BUDGET_DAILY_USD=4
ALERT_RESERVE_USD=1
SAM_MAX_PER_HOUR=300
SAM_MAX_PER_MIN=20
SPARK_MAX_PER_HOUR=120
ASR_MAX_SEC_PER_DAY=1800

# --- Timing (all rule times are India Standard Time, Asia/Kolkata) -------------------
CLAIM_TIMEOUT_SEC=120
DEMO_CLAIM_TIMEOUT_SEC=30

# --- Storage ---------------------------------------------------------------------
DATA_DIR=data
